# syntax=docker/dockerfile:1
# Base image digests recorded on 2026-10-05. Dependencies use the upstream lockfiles.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS frontend
WORKDIR /src
RUN npm install -g pnpm@10.28.0
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY frontend/ ./
RUN pnpm build

FROM golang:1.26.0@sha256:fb612b7831d53a89cbc0aaa7855b69ad7b0caf603715860cf538df854d047b84 AS backend
WORKDIR /src
ARG COMMIT
ARG VERSION=v0.26.2-custom
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
COPY --from=frontend /src/.output/public/ ./app/api/static/public/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath \
    -ldflags "-s -w -X main.commit=${COMMIT} -X main.version=${VERSION}" -o /homebox ./app/api

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates tzdata wget
ARG COMMIT
ARG VERSION=v0.26.2-custom
LABEL org.opencontainers.image.source="https://github.com/FelberPeter/homebox-custom" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.version="${VERSION}"
ENV HBOX_MODE=production \
    HBOX_STORAGE_CONN_STRING=file:///?no_tmp_dir=true \
    HBOX_STORAGE_PREFIX_PATH=data \
    HBOX_DATABASE_SQLITE_PATH="/data/homebox.db?_pragma=busy_timeout=2000&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite" \
    TZ=Europe/Berlin
WORKDIR /app
COPY --from=backend /homebox /app/api
EXPOSE 7745
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD wget -q -O /dev/null http://localhost:7745/api/v1/status || exit 1
ENTRYPOINT ["/app/api"]
CMD ["/data/config.yml"]
